//@version=6
// Parça Gold · S2C
// Port of the S2C engine (src/lib/parcaSetup.ts, preset "Gold"). Generated by
// scripts/build-pine.mjs: edit the template and rebuild, do not edit this file by hand.
//
// Rules: daily bias (1h / 4h / daily: two agree, none opposes) -> a closed candle engulfs an
// opposing FVG / order block (chart timeframe and 15m / 1h / 4h; stacked FVGs are one zone, a
// closed-through FVG turns into an iFVG) -> signal at the close, stop beyond the last swing
// (min 0.8 ATR), target 1R. Everything is computed on closed candles only: no repaint.
// Differences from S2C: no NFP / CPI / FOMC filter, and 4h / daily candles follow the broker's
// session on TradingView, so a few signals can differ.
indicator("Parça Gold · S2C", "PARÇA GOLD", overlay = true, max_labels_count = 500, max_boxes_count = 100, max_lines_count = 100)

// ── inputs: defaults are the S2C preset ──────────────────────────────────────────────────────
grpS = "Sinyal"
pivotN = input.int(2, "Mini yapı mum sayısı", minval = 1, maxval = 8, group = grpS)
windowN = input.int(10, "Engulf sonrası teyit mumu", minval = 1, maxval = 30, group = grpS)
zoneAge = input.int(80, "Bölge ömrü (mum)", minval = 10, maxval = 300, group = grpS)
minGap = input.float(0.25, "En küçük FVG (ATR katı)", minval = 0, step = 0.05, group = grpS)
useSession = input.bool(true, "Yalnız Londra / New York seansı", group = grpS)
useEma = input.bool(true, "EMA teyidi (EMA21 eğimi + 15dk EMA50)", group = grpS)
minAdx = input.float(20.0, "En düşük ADX (0 kapalı)", minval = 0, step = 0.5, group = grpS)
minP = input.float(0.0, "En düşük 1R olasılığı (0 kapalı)", minval = 0, maxval = 0.9, step = 0.05, group = grpS)
minRoom = input.float(2.0, "Önündeki seviyeye en az kaç R (0 kapalı)", minval = 0, maxval = 6, step = 0.5, group = grpS)
noOB = input.bool(true, "OB ve 4sa+ iFVG girişlerini atla", group = grpS)
grpV = "Görünüm"
showZones = input.bool(true, "Bölgeleri göster", group = grpV)
maxZones = input.int(8, "Gösterilecek bölge sayısı", minval = 0, maxval = 20, group = grpV)
showLevels = input.bool(true, "Son sinyalin giriş / stop / hedef çizgileri", group = grpV)
labelSizeIn = input.string("normal", "Etiket boyu", options = ["small", "normal", "large"], group = grpV)
labelSize = labelSizeIn == "small" ? size.small : labelSizeIn == "large" ? size.large : size.normal

NAME = "GOLD"
UP = #26a69a
DN = #ef5350
GOLD = #e8c46e
HOUR = 3600000

// ── helpers ─────────────────────────────────────────────────────────────────────────────────
f_trend(c1, h1, l1, c2, h2, l2) =>
    c1 > c2 and h1 > h2 ? 1 : c1 < c2 and l1 < l2 ? -1 : 0

// trend of the last two candles of `tf` that are closed by the close of the current chart bar
f_closedTrend(tf) =>
    [c0, h0, l0, c1, h1, l1, c2, h2, l2] = request.security(syminfo.tickerid, tf, [close, high, low, close[1], high[1], low[1], close[2], high[2], low[2]], lookahead = barmerge.lookahead_on)
    time_close == time_close(tf) ? f_trend(c0, h0, l0, c1, h1, l1) : f_trend(c1, h1, l1, c2, h2, l2)

f_tfName(sec) =>
    sec == 300 ? "5dk" : sec == 900 ? "15dk" : sec == 3600 ? "1sa" : sec == 14400 ? "4sa" : ""

// FVG (stacked) and order block of the current candle of whatever timeframe this runs on
f_detect(gapAtr, pv) =>
    var float hi = na
    var float lo = na
    var int upK = na
    var float upB = na
    var float upT = na
    var int dnK = na
    var float dnB = na
    var float dnT = na
    a = ta.atr(14)
    int fSide = 0
    float fBot = na
    float fTop = na
    bool fRep = false
    int oSide = 0
    float oBot = na
    float oTop = na
    // a stack ends when its own timeframe closes through it
    if not na(upK) and close < upB
        upK := na
    if not na(dnK) and close > dnT
        dnK := na
    if bar_index >= 2
        mv = na(a[1]) ? 0.0 : a[1] * gapAtr
        if low - high[2] > mv
            fSide := 1
            fBot := high[2]
            fTop := low
            if not na(upK) and bar_index - upK <= 8
                fBot := math.min(fBot, upB)
                fTop := math.max(fTop, upT)
                fRep := true
            upK := bar_index
            upB := fBot
            upT := fTop
        else if low[2] - high > mv
            fSide := -1
            fBot := high
            fTop := low[2]
            if not na(dnK) and bar_index - dnK <= 8
                fBot := math.min(fBot, dnB)
                fTop := math.max(fTop, dnT)
                fRep := true
            dnK := bar_index
            dnB := fBot
            dnT := fTop
    if bar_index >= pv * 2
        bool isH = true
        bool isL = true
        for j = 0 to pv * 2
            if j != pv
                if high[j] >= high[pv]
                    isH := false
                if low[j] <= low[pv]
                    isL := false
        if isH
            hi := high[pv]
        if isL
            lo := low[pv]
    // order block: last opposite candle before a close through a swing and beyond the block
    if not na(hi) and close > hi and close[1] <= hi
        for j = 1 to math.min(5, bar_index)
            if close[j] < open[j]
                if close > high[j]
                    oSide := 1
                    oBot := low[j]
                    oTop := high[j]
                break
        hi := na
    if not na(lo) and close < lo and close[1] >= lo
        for j = 1 to math.min(5, bar_index)
            if close[j] > open[j]
                if close < low[j]
                    oSide := -1
                    oBot := low[j]
                    oTop := high[j]
                break
        lo := na
    [fSide, fBot, fTop, fRep, oSide, oBot, oTop]

// ── data from closed candles ────────────────────────────────────────────────────────────────
chartSec = timeframe.in_seconds()
atr14 = ta.atr(14)
atrAvg = ta.sma(atr14, 288)
e21 = ta.ema(close, 21)
[diP, diM, adxV] = ta.dmi(14, 14)
rsiV = ta.rsi(close, 14)
low11 = ta.lowest(low, 11)
high11 = ta.highest(high, 11)

trend1h = f_closedTrend("60")
trend4h = f_closedTrend("240")
trendD = f_closedTrend("D")
votesUp = (trend1h == 1 ? 1 : 0) + (trend4h == 1 ? 1 : 0) + (trendD == 1 ? 1 : 0)
votesDn = (trend1h == -1 ? 1 : 0) + (trend4h == -1 ? 1 : 0) + (trendD == -1 ? 1 : 0)
bias = votesUp >= 2 and votesDn == 0 ? 1 : votesDn >= 2 and votesUp == 0 ? -1 : 0

[q0, qe0, q1, qe1] = request.security(syminfo.tickerid, "15", [close, ta.ema(close, 50), close[1], ta.ema(close, 50)[1]], lookahead = barmerge.lookahead_on)
own50 = ta.ema(close, 50)
q15last = time_close == time_close("15")
qClose = chartSec >= 900 ? close : q15last ? q0 : q1
qEma = chartSec >= 900 ? own50 : q15last ? qe0 : qe1

[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
newDay = ta.change(time("D")) != 0
inL = not na(time(timeframe.period, "0800-1600", "Europe/London"))
inN = not na(time(timeframe.period, "0800-1700", "America/New_York"))
inAsia = not inL and not inN

// zones of every timeframe, read on the chart bar that closes that timeframe's candle
[c_fs, c_fb, c_ft, c_fr, c_os, c_ob, c_ot] = f_detect(minGap, pivotN)
[a_fs, a_fb, a_ft, a_fr, a_os, a_ob, a_ot] = request.security(syminfo.tickerid, "5", f_detect(minGap, pivotN), lookahead = barmerge.lookahead_on)
[b_fs, b_fb, b_ft, b_fr, b_os, b_ob, b_ot] = request.security(syminfo.tickerid, "15", f_detect(minGap, pivotN), lookahead = barmerge.lookahead_on)
[h_fs, h_fb, h_ft, h_fr, h_os, h_ob, h_ot] = request.security(syminfo.tickerid, "60", f_detect(minGap, pivotN), lookahead = barmerge.lookahead_on)
[g_fs, g_fb, g_ft, g_fr, g_os, g_ob, g_ot] = request.security(syminfo.tickerid, "240", f_detect(minGap, pivotN), lookahead = barmerge.lookahead_on)
last5 = time_close == time_close("5")
last15 = time_close == time_close("15")
last60 = time_close == time_close("60")
last240 = time_close == time_close("240")

// ── engine state ────────────────────────────────────────────────────────────────────────────
var zB = array.new_float()
var zT = array.new_float()
var zS = array.new_int()
var zSrc = array.new_int()     // 0 FVG, 1 iFVG, 2 OB
var zTf = array.new_int()      // seconds
var zRank = array.new_int()
var zFrom = array.new_int()
var zUntil = array.new_int()
var zDead = array.new_bool()
var zId = array.new_int()
var lastFvg = array.new_int(10, -1)   // per timeframe slot and side: id of the last FVG
var int nextId = 0
// zones found on this bar, inserted when the next bar opens
var pB = array.new_float()
var pT = array.new_float()
var pS = array.new_int()
var pSrc = array.new_int()
var pTf = array.new_int()
var pRank = array.new_int()
var pRep = array.new_bool()
var pSlot = array.new_int()

var float pivH = na
var int pivHAt = -1
var float pivL = na
var int pivLAt = -1
var int mspL = -1
var int mspS = -1
var int poiL = 0
var int poiS = 0
// session liquidity of the trading day
var lvP = array.new_float()
var lvHigh = array.new_bool()
var lvDone = array.new_bool()
var lvPier = array.new_int()
var float asiaH = na
var float asiaL = na
var float lonH = na
var float lonL = na
var bool asiaPub = false
var bool lonPub = false
var bool sweptL = false
var bool sweptS = false
// latest signal, for the level lines
var int sigBar = na
var int sigSide = 0
var float sigEntry = na
var float sigStop = na
var float sigTarget = na
var float sigLiq = na
var float sigProb = na
var bool sigStrong = false
var string lastText = "—"

f_queue(side, bot, top, src, tfSec, rank, rep, slot) =>
    if side != 0
        array.push(pB, bot)
        array.push(pT, top)
        array.push(pS, side)
        array.push(pSrc, src)
        array.push(pTf, tfSec)
        array.push(pRank, rank)
        array.push(pRep, rep)
        array.push(pSlot, slot)

f_prob(adx, vol, slope21, ext21, rsi, engulfRatio, riskAtr, room, m15, htf) =>
    float s = 0.19932
    s += -0.04546 * (adx - 28.77603) / 7.34747
    s += 0.62412 * (math.min(vol, 2.5) - 1.29264) / 0.39748
    s += 0.02307 * (math.max(-1.0, math.min(1.5, slope21)) - 0.45865) / 0.4949
    s += 0.10077 * (math.max(-1.0, math.min(4.0, ext21)) - 1.67892) / 1.00168
    s += 0.24658 * (rsi - 64.17223) / 8.5348
    s += -0.14478 * (math.log(math.max(0.2, math.min(10.0, engulfRatio))) - 0.53288) / 1.03129
    s += -0.25545 * (math.min(6.0, riskAtr) - 3.19419) / 1.23408
    s += 0.20423 * (math.min(3.0, room) - 1.15439) / 1.40913
    s += 0.05299 * ((m15 ? 1.0 : 0.0) - 0.87742) / 0.32796
    s += -0.24789 * ((htf ? 1.0 : 0.0) - 0.49032) / 0.49991
    1.0 / (1.0 + math.exp(-s))

bool longSig = false
bool shortSig = false

if barstate.isconfirmed
    now = time_close
    // session liquidity: previous day high / low, then the Asia and London ranges
    if newDay
        array.clear(lvP)
        array.clear(lvHigh)
        array.clear(lvDone)
        array.clear(lvPier)
        asiaH := na
        asiaL := na
        lonH := na
        lonL := na
        asiaPub := false
        lonPub := false
        sweptL := false
        sweptS := false
        if not na(pdH)
            array.push(lvP, pdH)
            array.push(lvHigh, true)
            array.push(lvDone, false)
            array.push(lvPier, -1)
            array.push(lvP, pdL)
            array.push(lvHigh, false)
            array.push(lvDone, false)
            array.push(lvPier, -1)
    if not inAsia and not na(asiaH) and not asiaPub
        asiaPub := true
        array.push(lvP, asiaH)
        array.push(lvHigh, true)
        array.push(lvDone, false)
        array.push(lvPier, -1)
        array.push(lvP, asiaL)
        array.push(lvHigh, false)
        array.push(lvDone, false)
        array.push(lvPier, -1)
    if inN and not na(lonH) and not lonPub
        lonPub := true
        array.push(lvP, lonH)
        array.push(lvHigh, true)
        array.push(lvDone, false)
        array.push(lvPier, -1)
        array.push(lvP, lonL)
        array.push(lvHigh, false)
        array.push(lvDone, false)
        array.push(lvPier, -1)
    if array.size(lvP) > 0
        for k = 0 to array.size(lvP) - 1
            if not array.get(lvDone, k)
                lp = array.get(lvP, k)
                isHi = array.get(lvHigh, k)
                beyond = isHi ? high > lp : low < lp
                back = isHi ? close < lp : close > lp
                pier = array.get(lvPier, k)
                if beyond or pier >= 0
                    if back
                        array.set(lvDone, k, true)
                        if isHi
                            sweptS := true
                        else
                            sweptL := true
                    else if pier < 0
                        array.set(lvPier, k, bar_index)
                    else if bar_index - pier >= 3
                        array.set(lvDone, k, true)
    if inAsia
        asiaH := na(asiaH) ? high : math.max(asiaH, high)
        asiaL := na(asiaL) ? low : math.min(asiaL, low)
    else if inL and not inN
        lonH := na(lonH) ? high : math.max(lonH, high)
        lonL := na(lonL) ? low : math.min(lonL, low)

    // zones that existed before this candle opened
    if array.size(pB) > 0
        for k = 0 to array.size(pB) - 1
            side = array.get(pS, k)
            src = array.get(pSrc, k)
            slot = array.get(pSlot, k) * 2 + (side == 1 ? 0 : 1)
            tfSec = array.get(pTf, k)
            if src == 0 and array.get(pRep, k) and array.size(zId) > 0
                old = array.get(lastFvg, slot)
                for q = 0 to array.size(zId) - 1
                    if array.get(zId, q) == old and array.get(zSrc, q) == 0
                        array.set(zDead, q, true)
            array.push(zB, array.get(pB, k))
            array.push(zT, array.get(pT, k))
            array.push(zS, side)
            array.push(zSrc, src)
            array.push(zTf, tfSec)
            array.push(zRank, array.get(pRank, k))
            array.push(zFrom, time)
            array.push(zUntil, time + zoneAge * tfSec * 1000)
            array.push(zDead, false)
            array.push(zId, nextId)
            if src == 0
                array.set(lastFvg, slot, nextId)
            nextId += 1
        array.clear(pB)
        array.clear(pT)
        array.clear(pS)
        array.clear(pSrc)
        array.clear(pTf)
        array.clear(pRank)
        array.clear(pRep)
        array.clear(pSlot)
    if array.size(zB) > 160
        for k = array.size(zB) - 1 to 0
            if array.get(zDead, k) or array.get(zUntil, k) < now
                array.remove(zB, k)
                array.remove(zT, k)
                array.remove(zS, k)
                array.remove(zSrc, k)
                array.remove(zTf, k)
                array.remove(zRank, k)
                array.remove(zFrom, k)
                array.remove(zUntil, k)
                array.remove(zDead, k)
                array.remove(zId, k)

    // swing points of the chart timeframe
    if bar_index >= pivotN * 2
        bool isH = true
        bool isL = true
        for j = 0 to pivotN * 2
            if j != pivotN
                if high[j] >= high[pivotN]
                    isH := false
                if low[j] <= low[pivotN]
                    isL := false
        if isH
            pivH := high[pivotN]
            pivHAt := bar_index - pivotN
        if isL
            pivL := low[pivotN]
            pivLAt := bar_index - pivotN

    // zone life cycle on this close; an engulf is a close through an opposing zone
    int bestUp = -1
    int bestDn = -1
    if array.size(zB) > 0
        for k = 0 to array.size(zB) - 1
            if not array.get(zDead, k) and array.get(zUntil, k) >= now
                zb = array.get(zB, k)
                zt = array.get(zT, k)
                zs = array.get(zS, k)
                if array.get(zTf, k) >= 3600 and (zs == 1 ? low <= zt and close > zb : high >= zb and close < zt)
                    if zs == 1
                        poiL := time
                    else
                        poiS := time
                up = zs == -1 and close > zt
                down = zs == 1 and close < zb
                if up or down
                    body = up ? close > open and close[1] <= zt : close < open and close[1] >= zb
                    if body
                        best = up ? bestUp : bestDn
                        bool better = true
                        if best >= 0
                            rk = array.get(zRank, k)
                            rb = array.get(zRank, best)
                            better := rk > rb or (rk == rb and zt - zb > array.get(zT, best) - array.get(zB, best))
                        if better
                            if up
                                bestUp := k
                            else
                                bestDn := k
                    if array.get(zSrc, k) == 0
                        array.set(zSrc, k, 1)
                        array.set(zS, k, up ? 1 : -1)
                    else
                        array.set(zDead, k, true)

    // mini structure point: a close beyond the last swing
    brokeUp = bar_index - pivHAt <= 40 and not na(pivH) and close > pivH and close[1] <= pivH
    brokeDn = bar_index - pivLAt <= 40 and not na(pivL) and close < pivL and close[1] >= pivL
    if brokeUp
        mspL := bar_index
    if brokeDn
        mspS := bar_index

    for n = 0 to 1
        way = n == 0 ? 1 : -1
        zk = way == 1 ? bestUp : bestDn
        if zk >= 0 and bias == way
            hasPoi = time - (way == 1 ? poiL : poiS) <= 2 * HOUR
            msp = way == 1 ? mspL : mspS
            dbl = msp >= 0 and bar_index - msp <= windowN
            sessOk = not useSession or not inAsia
            emaOk = not useEma or (bar_index >= 5 and way * (e21 - e21[5]) > 0 and not na(qEma) and way * (qClose - qEma) > 0)
            adxOk = minAdx <= 0 or adxV >= minAdx
            if sessOk and emaOk and adxOk
                pad = na(atr14) ? 0.0 : atr14
                stop = way == 1 ? math.min(low11 - pad * 0.1, close - pad * 0.8) : math.max(high11 + pad * 0.1, close + pad * 0.8)
                risk = math.abs(close - stop)
                float opp = na
                for j = 3 to 48
                    if bar_index - j >= 0
                        v = way == 1 ? high[j] : low[j]
                        if way * (v - close) > 0
                            opp := na(opp) ? v : way == 1 ? math.min(opp, v) : math.max(opp, v)
                room = na(opp) ? 9.0 : math.abs(opp - close) / risk
                prevBody = math.max(1e-9, math.abs(close[1] - open[1]))
                zTfK = array.get(zTf, zk)
                prob = pad > 0 and bar_index >= 5 ? f_prob(adxV, atr14 / atrAvg, way * (e21 - e21[5]) / pad, way * (close - e21) / pad, way == 1 ? rsiV : 100 - rsiV, math.abs(close - open) / prevBody, risk / pad, room, not na(qEma) and way * (qClose - qEma) > 0, zTfK != chartSec and zTfK >= 900) : na
                zsrcK = array.get(zSrc, zk)
                zoneOk = not noOB or not (zsrcK == 2 or (zsrcK == 1 and zTfK >= 14400))
                roomOk = minRoom <= 0 or na(opp) or room >= minRoom
                if zoneOk and roomOk and (minP <= 0 or (not na(prob) and prob >= minP))
                    strong = dbl or (way == 1 ? sweptL : sweptS) or hasPoi
                    zsrc = array.get(zSrc, zk)
                    srcName = (zTfK != chartSec ? f_tfName(zTfK) + " " : "") + (zsrc == 2 ? "OB" : zsrc == 1 ? "iFVG" : "FVG")
                    pct = na(prob) ? "" : " %" + str.tostring(math.round(prob * 100))
                    txt = NAME + (way == 1 ? " ↑ AL" : " ↓ SAT") + (strong ? " ★" : "") + pct
                    label.new(bar_index, way == 1 ? low - pad * 0.4 : high + pad * 0.4, txt + "\n" + srcName, style = way == 1 ? label.style_label_up : label.style_label_down, color = way == 1 ? UP : DN, textcolor = color.white, size = labelSize)
                    sigBar := bar_index
                    sigSide := way
                    sigEntry := close
                    sigStop := stop
                    sigTarget := close + (close - stop)
                    sigLiq := na(opp) ? na : room
                    sigProb := prob
                    sigStrong := strong
                    lastText := txt
                    if way == 1
                        longSig := true
                    else
                        shortSig := true
                    alert(syminfo.ticker + " " + txt + " | giriş " + str.tostring(close, format.mintick) + " stop " + str.tostring(stop, format.mintick) + " hedef 1R " + str.tostring(sigTarget, format.mintick), alert.freq_once_per_bar_close)

    // zones found on this close, available from the next candle
    f_queue(c_fs, c_fb, c_ft, 0, chartSec, 0, c_fr, 0)
    f_queue(c_os, c_ob, c_ot, 2, chartSec, 0, false, 0)
    int rank = 1
    if 300 > chartSec and last5
        f_queue(a_fs, a_fb, a_ft, 0, 300, rank, a_fr, 1)
        f_queue(a_os, a_ob, a_ot, 2, 300, rank, false, 1)
    if 300 > chartSec
        rank += 1
    if 900 > chartSec and last15
        f_queue(b_fs, b_fb, b_ft, 0, 900, rank, b_fr, 2)
        f_queue(b_os, b_ob, b_ot, 2, 900, rank, false, 2)
    if 900 > chartSec
        rank += 1
    if 3600 > chartSec and last60
        f_queue(h_fs, h_fb, h_ft, 0, 3600, rank, h_fr, 3)
        f_queue(h_os, h_ob, h_ot, 2, 3600, rank, false, 3)
    if 3600 > chartSec
        rank += 1
    if 14400 > chartSec and last240
        f_queue(g_fs, g_fb, g_ft, 0, 14400, rank, g_fr, 4)
        f_queue(g_os, g_ob, g_ot, 2, 14400, rank, false, 4)

alertcondition(longSig, NAME + " AL", NAME + " AL sinyali")
alertcondition(shortSig, NAME + " SAT", NAME + " SAT sinyali")

// ── the latest signal: entry, stop, 1R target, while it is alive ────────────────────────────
var line lnE = na
var line lnS = na
var line lnT = na
var label lbE = na
var label lbS = na
var label lbT = na
if barstate.isconfirmed and not na(sigBar)
    done = sigSide == 1 ? low <= sigStop or high >= sigTarget : high >= sigStop or low <= sigTarget
    alive = showLevels and bar_index - sigBar <= 60 and not (bar_index > sigBar and done)
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT)
    if alive
        x2 = bar_index + 8
        lnE := line.new(sigBar, sigEntry, x2, sigEntry, color = sigSide == 1 ? UP : DN, width = 2)
        lnS := line.new(sigBar, sigStop, x2, sigStop, color = DN, width = 1, style = line.style_dashed)
        lnT := line.new(sigBar, sigTarget, x2, sigTarget, color = UP, width = 1, style = line.style_dashed)
        liqTxt = na(sigLiq) ? "açık" : str.replace(str.tostring(sigLiq, "#.#"), ".", ",") + "R"
        lbE := label.new(x2, sigEntry, (sigSide == 1 ? "AL" : "SAT") + " · GİRİŞ" + (sigStrong ? " ★" : ""), style = label.style_label_left, color = sigSide == 1 ? UP : DN, textcolor = color.white, size = labelSize)
        lbS := label.new(x2, sigStop, "STOP −1R", style = label.style_label_left, color = DN, textcolor = color.white, size = labelSize)
        lbT := label.new(x2, sigTarget, "HEDEF 1R · likidite " + liqTxt, style = label.style_label_left, color = UP, textcolor = color.white, size = labelSize)

// ── zones nearest to price ──────────────────────────────────────────────────────────────────
var zoneBoxes = array.new_box()
if barstate.islast
    while array.size(zoneBoxes) > 0
        box.delete(array.pop(zoneBoxes))
    if showZones and maxZones > 0 and array.size(zB) > 0
        dist = array.new_float()
        idx = array.new_int()
        for k = 0 to array.size(zB) - 1
            if not array.get(zDead, k) and array.get(zUntil, k) >= time_close
                array.push(dist, math.min(math.abs(array.get(zT, k) - close), math.abs(array.get(zB, k) - close)))
                array.push(idx, k)
        if array.size(dist) > 0
            ord = array.sort_indices(dist, order.ascending)
            for n = 0 to math.min(maxZones, array.size(ord)) - 1
                k = array.get(idx, array.get(ord, n))
                zs = array.get(zS, k)
                zsrc = array.get(zSrc, k)
                tone = zs == 1 ? UP : DN
                name = (array.get(zTf, k) != chartSec ? f_tfName(array.get(zTf, k)) + " " : "") + (zsrc == 2 ? "OB" : zsrc == 1 ? "iFVG" : "FVG")
                array.push(zoneBoxes, box.new(array.get(zFrom, k), array.get(zT, k), time_close, array.get(zB, k), xloc = xloc.bar_time, extend = extend.right, border_color = color.new(tone, 60), bgcolor = color.new(tone, 90), text = name, text_size = size.small, text_color = color.new(tone, 20), text_halign = text.align_right, text_valign = text.align_top))

// ── status ──────────────────────────────────────────────────────────────────────────────────
var table status = table.new(position.top_right, 1, 2, border_width = 1)
if barstate.islast
    table.cell(status, 0, 0, "BIAS: " + (bias == 1 ? "YUKARI" : bias == -1 ? "AŞAĞI" : "BELİRSİZ"), bgcolor = bias == 1 ? UP : bias == -1 ? DN : color.gray, text_color = color.white, text_size = size.normal)
    table.cell(status, 0, 1, "Son: " + lastText, bgcolor = color.new(GOLD, 0), text_color = color.black, text_size = size.normal)
