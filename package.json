{
  "name": "s2c",
  "private": true,
  "version": "1.0.0",
  "description": "S2C — yerel XAU/USD kör replay ve sanal prop hesap çalışma ortamı",
  "author": "S2C",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test-core.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "start": "vite build && vite preview --port 5199 --strictPort",
    "desktop": "npm run build && npm run make:icon && electron .",
    "make:icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && npm run make:icon && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "dukascopy-node": "^1.51.1",
    "idb": "^8.0.4",
    "lightweight-charts": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7",
    "vite": "^7.3.8",
    "@vitejs/plugin-react": "^5.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "playwright-core": "^1.64.1",
    "typescript": "5.6"
  },
  "build": {
    "appId": "com.s2c.desktop",
    "productName": "S2C",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "vite.config.ts", "index.html", "package.json"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "electron/assets/s2c.ico",
      "artifactName": "S2C-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
