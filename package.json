{
  "name": "s2c",
  "private": true,
  "version": "1.0.0",
  "description": "S2C: yerel XAU/USD kör replay ve sanal prop hesap çalışma ortamı",
  "author": "S2C",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test-core.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "start": "vite build && vite preview --port 5199 --strictPort",
    "build:web": "vite build",
    "launch": "node scripts/launch.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "dukascopy-node": "^1.51.1",
    "idb": "^8.0.4",
    "lightweight-charts": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7",
    "vite": "^7.3.8",
    "@vitejs/plugin-react": "^5.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1",
    "typescript": "5.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
